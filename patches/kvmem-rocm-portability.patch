 #include "ggml-cuda.h"
+
+// ROCm/HIP portability: the HIP CUDA-compatibility layer maps most cuda* names but not
+// this enum. Upstream master still uses the bare CUDA spelling (checked 2026-09-27), so a
+// HIP build needs the alias. Guarded on GGML_USE_HIP so CUDA builds are unaffected.
+#if defined(GGML_USE_HIP) && !defined(KVMEM_CUDA_OOM_ALIAS)
+#    define KVMEM_CUDA_OOM_ALIAS 1
+#    define cudaErrorMemoryAllocation hipErrorMemoryAllocation
+#endif
 
