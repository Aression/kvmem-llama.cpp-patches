+void llama_memory_kvmem::score_top_kvmem_trace(const char * tag, const std::vector<double> & scores) {
+    if (scores.empty()) {
+        return;
+    }
+    const size_t top_n = std::min<size_t>(10, scores.size());
+    std::vector<uint32_t> idx(scores.size());
+    std::iota(idx.begin(), idx.end(), 0);
+    std::partial_sort(idx.begin(), idx.begin() + top_n, idx.end(),
+            [&](uint32_t a, uint32_t b) { return scores[a] > scores[b]; });
+    std::string out;
+    for (size_t i = 0; i < top_n; ++i) {
+        if (i) {
+            out += ',';
+        }
+        out += std::to_string(idx[i]) + ":" + std::to_string(scores[idx[i]]);
+    }
+    kvmem_diag("KVMEM_TRACE score_top %s=%s\n", tag, out.c_str());
 }
 
