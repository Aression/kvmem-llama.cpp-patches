+    const auto read_stored = [&](const LayerBlk & lb) {
+        if (lb.minmax_tokens == 0 || lb.k_min.size() != cfg_.n_embd_k) {
+            return false;
+        }
+        for (uint32_t d = 0; d < cfg_.n_embd_k; ++d) {
+            min_out[d] = f16_to_f32(lb.k_min[d]);
+            max_out[d] = f16_to_f32(lb.k_max[d]);
+        }
+        return true;
+    };
+    if (block_id >= blocks_.size() || il >= cfg_.n_layer) {
+        std::fill_n(min_out, cfg_.n_embd_k, 0.0f);
+        std::fill_n(max_out, cfg_.n_embd_k, 0.0f);
+        return;
+    }
+    if (read_stored(blocks_[block_id].layers[il])) {
+        return;
+    }
+    std::fill_n(min_out, cfg_.n_embd_k, 0.0f);
+    std::fill_n(max_out, cfg_.n_embd_k, 0.0f);
