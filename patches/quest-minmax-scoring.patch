+void llama_memory_kvmem::score_retrieval_bound(std::vector<double> & scores) {
+    auto & store = runtime_->store();
+    const uint32_t nblk = store.block_count();
+    std::vector<float> kmin(n_embd_k_, 0.0f);
+    std::vector<float> kmax(n_embd_k_, 0.0f);
+    const uint32_t g = n_head_kv_ == 0 ? 1 : n_head_ / n_head_kv_;
+    for (uint32_t b = 0; b < nblk; ++b) {
+        if (!raw_->has_block(b)) {
+            continue;
+        }
+        double acc = 0;
+        uint32_t nlay = 0;
+        for (uint32_t il = 0; il < n_layer_; ++il) {
+            if (q_count_[il] == 0) {
+                continue;
+            }
+            raw_->minmax_k(b, il, kmin.data(), kmax.data());
+            double layer = 0;
+            const float invq = 1.0f / static_cast<float>(q_count_[il] * std::max(1u, g));
+            for (uint32_t h = 0; h < n_head_kv_; ++h) {
+                std::vector<float> qh(n_embd_head_, 0.0f);
+                for (uint32_t gi = 0; gi < g; ++gi) {
+                    const uint32_t qh_i = h * g + gi;
+                    if (qh_i >= n_head_) {
+                        break;
+                    }
+                    const float * q = q_sum_[il].data() + qh_i * n_embd_head_;
+                    for (uint32_t d = 0; d < n_embd_head_; ++d) {
+                        qh[d] += q[d];
+                    }
+                }
+                const float * kn = kmin.data() + h * n_embd_head_;
+                const float * kx = kmax.data() + h * n_embd_head_;
+                float dot = 0, nq = 0, nb = 0;
+                for (uint32_t d = 0; d < n_embd_head_; ++d) {
+                    const float qv = qh[d] * invq;
+                    const float bv = qv >= 0 ? kx[d] : kn[d];
+                    dot += qv * bv;
+                    nq += qv * qv;
+                    nb += bv * bv;
+                }
+                layer += dot / (std::sqrt(nq) * std::sqrt(nb) + 1e-6f);
+            }
+            acc += layer / static_cast<double>(std::max(1u, n_head_kv_));
+            nlay++;
+        }
+        scores[b] = nlay ? acc / nlay : 0;
+    }
+}
